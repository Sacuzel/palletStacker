<?xml version="1.0"?>
<model>
  <name>Simplified EUR pallet</name>
  <version>1.1</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>JIS Automation pallet loader project</name>
  </author>
  <description>
    Dynamic 1200 x 800 x 144 mm EUR-pallet approximation for Gazebo Harmonic.
    The model uses one rigid link, five primitive box collisions, a 25 kg
    compound inertia, and a named loading_surface frame at z=0.144 m.
    Model axes match the pallet-loader application: X=length and Y=width.
  </description>
</model>
