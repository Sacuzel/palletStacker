<?xml version="1.0"?>
<sdf version="1.10">
  <!-- Minimal development harness, separate from gzSimulator.py output. -->
  <world name="forklift_test">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.78 0.8 0.84 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose><cast_shadows>false</cast_shadows>
      <direction>-0.5 0.2 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <max_contacts>4</max_contacts>
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.58 0.6 0.62 1</ambient><diffuse>0.58 0.6 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://simple_forklift</uri>
      <pose>0 0 0.001 0 0 0</pose>
    </include>
  </world>
</sdf>
