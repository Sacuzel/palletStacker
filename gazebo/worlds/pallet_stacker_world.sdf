              <restitution_coefficient>0</restitution_coefficient>
              <threshold>100000</threshold>
            </bounce>
            <contact>
              <ode>
                <kp>1000000</kp>
                <kd>100</kd>
                <max_vel>1</max_vel>
                <min_depth>0.0005</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.08 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.22 0.24 0.27 1</ambient>
            <diffuse>0.32 0.35 0.40 1</diffuse>
            <specular>0.55 0.55 0.55 1</specular>
          </material>
        </visual>
      </link>
      <joint name="left_fork_lift_joint" type="prismatic">
        <parent>body</parent>
        <child>left_fork</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>0</lower>
            <upper>1.8</upper>
            <effort>12000</effort>
          </limit>
          <dynamics>
            <damping>50</damping>
            <friction>10</friction>
          </dynamics>
        </axis>
      </joint>
      <joint name="right_fork_lift_joint" type="prismatic">
        <parent>body</parent>
        <child>right_fork</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>0</lower>
            <upper>1.8</upper>
            <effort>12000</effort>
          </limit>
          <dynamics>
            <damping>50</damping>
            <friction>10</friction>
          </dynamics>
        </axis>
      </joint>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/forklift/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>left_fork_lift_joint</joint_name>
        <joint_name>right_fork_lift_joint</joint_name>
        <topic>/forklift/fork_position</topic>
        <initial_position>0</initial_position>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>0.5</cmd_max>
        <cmd_min>-0.5</cmd_min>
      </plugin>
    </model>
  </world>
</sdf>
