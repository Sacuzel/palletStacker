+  <version>1.0</version>
+  <sdf version="1.10">model.sdf</sdf>
+  <author>
+    <name>JIS Automation pallet-loader project</name>
+  </author>
+  <description>
+    Three-link dynamic forklift: one rectangular body and two independently
+    jointed rectangular fork tines. Runtime dimensions and control parameters
+    are applied by gazebo_exporter.py from config.py.
+  </description>
