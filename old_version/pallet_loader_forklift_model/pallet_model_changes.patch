+
+      <!-- Top deck: top face is exactly z=144 mm. -->
+      <collision name="top_deck_collision">
+        <pose>0 0 0.133 0 0 0</pose>
+        <geometry><box><size>0.8 1.2 0.022</size></box></geometry>
+        <surface>
+          <friction><ode><mu>0.65</mu><mu2>0.65</mu2></ode></friction>
+          <bounce><restitution_coefficient>0</restitution_coefficient><threshold>100000</threshold></bounce>
+          <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>1</max_vel><min_depth>0.0005</min_depth></ode></contact>
+        </surface>
+      </collision>
+      <visual name="top_deck_visual">
+        <pose>0 0 0.133 0 0 0</pose>
+        <geometry><box><size>0.8 1.2 0.022</size></box></geometry>
+        <material>
+          <ambient>0.50 0.31 0.11 1</ambient>
+          <diffuse>0.70 0.47 0.20 1</diffuse>
+          <specular>0.03 0.03 0.03 1</specular>
