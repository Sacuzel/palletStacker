<?xml version="1.0"?>
<sdf version="1.10">
  <!--
    Simplified electric warehouse forklift.

    Coordinate convention:
      +X = forward / fork direction
      +Y = left
      +Z = up

    The model has exactly three physical links:
      1. base_link       - one rectangular forklift body
      2. left_fork_link  - one rectangular fork tine
      3. right_fork_link - one rectangular fork tine

    The exporter applies the values from config.py when this model is inlined
    into the generated world. The values in this standalone file are the
    matching defaults and make the model directly inspectable in Gazebo.
  -->
  <model name="forklift">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <canonical_link>base_link</canonical_link>

    <!-- Simplified body based on a compact 3-wheel electric warehouse truck. -->
    <link name="base_link">
      <gravity>true</gravity>
      <kinematic>false</kinematic>
      <inertial>
        <pose>0 0 1.025 0 0 0</pose>
        <mass>2500</mass>
        <inertia>
          <ixx>1105.20833333</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1573.20833333</iyy>
          <iyz>0</iyz>
          <izz>927.375</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <pose>0 0 1.025 0 0 0</pose>
        <geometry><box><size>1.83 1.05 2.05</size></box></geometry>
        <surface>
          <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient><threshold>100000</threshold></bounce>
          <contact><ode><kp>2000000</kp><kd>200</kd><max_vel>0.5</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="body_visual">
        <pose>0 0 1.025 0 0 0</pose>
        <geometry><box><size>1.83 1.05 2.05</size></box></geometry>
        <material>
          <ambient>0.82 0.55 0.02 1</ambient>
          <diffuse>0.95 0.68 0.04 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
    </link>

    <!-- Initial fork bottom is 30 mm above the floor; top is 70 mm. -->
    <link name="left_fork_link">
      <pose>1.4485 0.275 0.05 0 0 0</pose>
      <gravity>true</gravity>
      <kinematic>false</kinematic>
      <inertial>
        <mass>35</mass>
        <inertia>
          <ixx>0.0350116667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.3252595833</iyy>
          <iyz>0</iyz>
          <izz>3.3509379167</izz>
        </inertia>
      </inertial>
      <collision name="left_fork_collision">
        <geometry><box><size>1.067 0.102 0.04</size></box></geometry>
        <surface>
          <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient><threshold>100000</threshold></bounce>
          <contact><ode><kp>2000000</kp><kd>200</kd><max_vel>0.5</max_vel><min_depth>0.0002</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="left_fork_visual">
        <geometry><box><size>1.067 0.102 0.04</size></box></geometry>
        <material>
          <ambient>0.18 0.18 0.18 1</ambient>
          <diffuse>0.30 0.30 0.30 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
    </link>

    <link name="right_fork_link">
      <pose>1.4485 -0.275 0.05 0 0 0</pose>
      <gravity>true</gravity>
      <kinematic>false</kinematic>
      <inertial>
        <mass>35</mass>
        <inertia>
          <ixx>0.0350116667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.3252595833</iyy>
          <iyz>0</iyz>
          <izz>3.3509379167</izz>
        </inertia>
      </inertial>
      <collision name="right_fork_collision">
        <geometry><box><size>1.067 0.102 0.04</size></box></geometry>
        <surface>
          <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient><threshold>100000</threshold></bounce>
          <contact><ode><kp>2000000</kp><kd>200</kd><max_vel>0.5</max_vel><min_depth>0.0002</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="right_fork_visual">
        <geometry><box><size>1.067 0.102 0.04</size></box></geometry>
        <material>
          <ambient>0.18 0.18 0.18 1</ambient>
          <diffuse>0.30 0.30 0.30 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
    </link>

    <!--
      Hard travel limit: initial fork top = 0.07 m and body top = 2.05 m,
      so the maximum permitted translation is 1.98 m. The fork upper faces
      can reach, but cannot pass, the upper face of the body.
    -->
    <joint name="left_fork_joint" type="prismatic">
      <parent>base_link</parent>
      <child>left_fork_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>0</lower><upper>1.98</upper><effort>250000</effort><velocity>0.15</velocity></limit>
        <dynamics><damping>50</damping><friction>5</friction></dynamics>
      </axis>
    </joint>

    <joint name="right_fork_joint" type="prismatic">
      <parent>base_link</parent>
      <child>right_fork_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>0</lower><upper>1.98</upper><effort>250000</effort><velocity>0.15</velocity></limit>
        <dynamics><damping>50</damping><friction>5</friction></dynamics>
      </axis>
    </joint>

    <!-- Direct planar model velocity. The GUI teleop plugin performs the ramp. -->
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/forklift/cmd_vel</topic>
    </plugin>

    <!-- One direct velocity controller per fork joint; both receive identical commands. -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>left_fork_joint</joint_name>
      <topic>/forklift/left_fork/cmd_vel</topic>
      <use_force_commands>false</use_force_commands>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>right_fork_joint</joint_name>
      <topic>/forklift/right_fork/cmd_vel</topic>
      <use_force_commands>false</use_force_commands>
    </plugin>
  </model>
</sdf>
