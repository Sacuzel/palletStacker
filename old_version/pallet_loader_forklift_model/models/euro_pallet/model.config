<?xml version="1.0"?>
<model>
  <name>Simplified EUR pallet</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>JIS Automation pallet loader project</name>
  </author>
  <description>
    Dynamic 800 x 1200 x 144 mm EUR-pallet approximation made from
    two 22 mm deck slabs and three 50 x 100 mm longitudinal stringers.
    The two channels are open through the 1200 mm direction for fork entry.
  </description>
</model>
